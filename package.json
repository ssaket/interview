{
  "name": "interview",
  "version": "1.0.0",
  "description": "DeepSeek Overlay Helper Application",
  "main": "src/js/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "test": "npm run test:all",
    "test:all": "node tests/test-llm-friendly-cleaner.js && node tests/test-markdown-sections.js && node tests/test-session.js",
    "test:cleaner": "node tests/test-llm-friendly-cleaner.js",
    "test:markdown": "node tests/test-markdown-sections.js",
    "test:session": "node tests/test-session.js",
    "analyze:responses": "node scripts/analyze-ai-responses.js 7",
    "analyze:responses:30d": "node scripts/analyze-ai-responses.js 30",
    "lint": "eslint src/js/**/*.js",
    "lint:fix": "eslint src/js/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "dist": "npm run build"
  },
  "keywords": [
    "electron",
    "deepseek",
    "overlay",
    "ocr",
    "ai"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.11.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.3",
    "assemblyai": "^4.16.0",
    "axios": "^1.10.0",
    "dotenv": "^16.5.0",
    "ffmpeg-static": "^5.2.0",
    "katex": "^0.16.22",
    "node-record-lpcm16": "^1.0.1",
    "openai": "^5.8.2",
    "selfsigned": "^3.0.1",
    "tesseract.js": "^6.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "electron": "^36.5.0",
    "electron-builder": "^26.0.12",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  },
  "build": {
    "appId": "com.interview.deepseek-overlay",
    "productName": "Overlay",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "index.html",
      "conversation-history-websocket.html",
      "eng.traineddata",
      "!tests/**/*",
      "!scripts/**/*",
      "!logs/**/*",
      "!.env",
      "!*.md"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
