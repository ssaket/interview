# AI Provider Configuration
# Choose between "huggingface" or "ollama"
# You can dynamically switch between providers using Cmd+Shift+P
# Session history is preserved when switching
AI_PROVIDER=ollama

# Hugging Face Configuration (when AI_PROVIDER=huggingface)
HF_TOKEN=your_huggingface_token_here
HF_PROVIDER=hyperbolic
HF_MODEL=deepseek-ai/DeepSeek-R1-0528

# Ollama Configuration (when AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1
OLLAMA_WARMUP=true

# DeepSeek R1 Performance Notes:
# - This is a reasoning model that "thinks" before responding
# - Typical response times:
#   * Simple questions: 10-30 seconds
#   * Coding problems: 60-90 seconds
#   * Complex algorithms: 90-180 seconds
# - Responses include <think> blocks showing reasoning process
# - First response after starting Ollama may take longer
# - Uses ~5GB RAM when loaded

# Provider Switching Features:
# - Cmd+Shift+P: Switch between Ollama and HuggingFace
# - Session history is automatically preserved during switches
# - UI shows current provider and connection status
# - Both providers must be properly configured for switching to work
# - Validation checks ensure providers are available before switching

# Keyboard Shortcuts Summary:
# - Cmd+A: Capture region behind overlay
# - Cmd+Shift+P: Switch AI provider (NEW!)
# - Opt+Cmd (Alt+Ctrl on Windows/Linux): Toggle AI flow
# - Cmd+Shift+W: Warm up Ollama model
# - Cmd+Shift+R: Reset session history
# - Cmd+B: Hide/show app
# - Cmd+Arrow Keys: Move window
# - Cmd+R/T: Start/stop audio recording

# DeepSeek Configuration (required for CLOUD, HYBRID and STEPS flows)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro

# DeepSeek V4 notes:
# - deepseek-chat / deepseek-reasoner were retired on 2026-07-24 and no longer work
# - One model serves both modes; thinking is switched per request, not per model
# - Thinking mode is chosen by flow: CLOUD = off, HYBRID/STEPS = on
# - deepseek-v4-flash is the cheaper alternative to deepseek-v4-pro
# DEEPSEEK_CLOUD_MODEL=deepseek-v4-flash
# DEEPSEEK_REASONING_EFFORT=high          # high (default) or max
# DEEPSEEK_REASONER_TIMEOUT=100000        # Thinking timeout for CLOUD/HYBRID flows
# DEEPSEEK_STEPS_TIMEOUT=240000           # Thinking timeout for STEPS flow optimization

# OpenAI Configuration (for Whisper transcription)
OPENAI_API_KEY=your_openai_api_key_here

# AssemblyAI Configuration (for speech-to-text)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here
